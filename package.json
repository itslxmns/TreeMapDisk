{
  "name": "disk-treemap",
  "productName": "Disk Treemap",
  "version": "1.0.0",
  "description": "See what's eating your disk as a treemap, and clean up node_modules, caches and build output in one click.",
  "author": "Disk Treemap contributors",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "treemap",
    "disk-usage",
    "cleanup",
    "node_modules"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.disktreemap",
    "productName": "Disk Treemap",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Disk Treemap",
      "artifactName": "DiskTreemap-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DiskTreemap-${version}-portable.${ext}"
    }
  }
}
